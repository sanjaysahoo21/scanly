# =================================================================
# Scanly — Environment Variables Template (.env.example)
# Copy this file to .env and fill in your actual credentials.
# =================================================================

# Server Configuration
SERVER_PORT=8081

# PostgreSQL Database Configuration
DB_URL=jdbc:postgresql://127.0.0.1:5433/scanly
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password_here

# JWT Security (Generate a secure base64-encoded 256-bit key)
SCANLY_JWT_SECRET=your_base64_secret_key_here
SCANLY_JWT_EXPIRATION_MS=86400000

# AI / OCR Service (Groq API)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
